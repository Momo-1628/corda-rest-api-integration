            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoiceNo\": \"INV-PM-{{$timestamp}}\",\n  \"buyer\": \"O=BuyerCorp,L=Bengaluru,C=IN\",\n  \"amount\": 125000.0,\n  \"currency\": \"INR\",\n  \"description\": \"Postman demo invoice\",\n  \"dueDate\": \"2026-12-31\"\n}",
              "options": {
                "raw": {
                  "language": "json"
